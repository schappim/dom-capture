{
  "manifest_version": 3,
  "name": "DOM Capture",
  "version": "1.0.0",
  "description": "Pick any element on a page and copy it — with all the styles it needs — as self-contained HTML you can paste anywhere.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Capture an element (Alt+Shift+C)",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Start / stop picking an element"
    }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
